# Supabase project (the SAME project as sos-caffe -- this platform lives in
# its own "platform" Postgres schema inside it, so these are the sos-caffe
# project's URL/keys, not a new project).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base domain this platform is served from. Each restaurant gets
# <slug>.BASE_DOMAIN once wildcard DNS + Vercel domain are configured.
# Until then, tenants are reachable at BASE_DOMAIN/<slug> as a fallback.
NEXT_PUBLIC_BASE_DOMAIN=orderbase.app

# Used by the create-restaurant provisioning script only (never read by
# the deployed app itself).
SUPABASE_DB_URL=postgres://postgres:password@db.your-project-ref.supabase.co:5432/postgres
